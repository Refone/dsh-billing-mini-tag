{
  "name": "dsh-billing-mini-tag",
  "version": "0.2.0",
  "private": true,
  "description": "DSH plugin: show the current session's spend (¥0.00) immediately to the right of the composer cache-hit statistics pill, priced from the official token quote",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "web",
    "billing"
  ],
  "license": "MIT"
}
