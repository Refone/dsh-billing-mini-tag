{
  "name": "dsh-billing-mini-tag",
  "version": "0.2.0",
  "description": "DSH plugin: show the current session's spend (¥0.00) immediately to the right of the composer cache-hit statistics pill, priced from the official token quote",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "showcase.png"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-release.mjs",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek",
    "deepseek-harness",
    "web",
    "billing",
    "cost",
    "token-usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Refone/dsh-billing-mini-tag.git"
  },
  "homepage": "https://github.com/Refone/dsh-billing-mini-tag#readme",
  "bugs": {
    "url": "https://github.com/Refone/dsh-billing-mini-tag/issues"
  },
  "license": "MIT"
}
